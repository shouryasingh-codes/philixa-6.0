PHILIXA_API_KEY=dev-api-key
PHILIXA_DATABASE_URL="postgresql+psycopg://postgres:password@localhost:5432/philixa"
PHILIXA_GEMINI_API_KEY=
PHILIXA_PROMPT_VERSION=v1-mvp-2026-06-19
PHILIXA_RAW_NOTES_MAX_CHARS=10000
PHILIXA_AI_TIMEOUT_SECONDS=20

# Primary AI provider (used by get_ai_provider())
PHILIXA_AI_PROVIDER=groq
PHILIXA_AI_MODEL=llama-3.3-70b-versatile
PHILIXA_AI_API_KEY=

# Demo access key — set to empty string to disable demo auth bypass
PHILIXA_DEMO_API_KEY=

# Voice AI Architecture
PHILIXA_TRANSCRIPTION_MODE=local
PHILIXA_DEEPGRAM_API_KEY=

# Redis
PHILIXA_REDIS_URL=redis://redis:6379/0

# MinIO
PHILIXA_MINIO_ENDPOINT=minio:9000
PHILIXA_MINIO_ACCESS_KEY=philixa_minio
PHILIXA_MINIO_SECRET_KEY=philixa_secret
PHILIXA_MINIO_BUCKET_NAME=philixa-documents
PHILIXA_RETAIN_AUDIO=0

# Economy SLM: Groq
PHILIXA_AI_ECONOMY_PROVIDER=groq
PHILIXA_AI_ECONOMY_MODEL=llama-3.3-70b-versatile

# Review LLM: Gemini — only called when Groq fails or is ambiguous
PHILIXA_AI_REVIEW_PROVIDER=gemini
PHILIXA_AI_REVIEW_MODEL=gemini-3.6-flash

# Groq API Key
PHILIXA_GROQ_API_KEY=

# Sarvam AI TTS Key (Optional, for native Hinglish voice)
PHILIXA_SARVAM_API_KEY=

PHILIXA_NOTIFICATION_MODE=email
PHILIXA_SMTP_HOSTNAME=smtp.gmail.com
PHILIXA_SMTP_PORT=587
PHILIXA_SMTP_USE_TLS=0
PHILIXA_SMTP_USERNAME=
PHILIXA_SMTP_PASSWORD=
PHILIXA_SMTP_FROM_ADDRESS=

PHILIXA_HF_TOKEN=
PHILIXA_CLIENT_AUTO_MATCH_THRESHOLD=0.95
